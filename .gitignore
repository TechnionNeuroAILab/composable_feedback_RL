# Ignore everything except code/, context/, paper/, and environment.yml
*

# But don't ignore these specific files/folders
!.gitignore
!code/
!code/**
!context/
!context/**
!paper/
!paper/**
!*.tex
!environment.yml
!2layers_dqns/
!2layers_dqns/**
!cleanRL_models/
!cleanRL_models/**
!bike_env/
!bike_env/**
!hyperparameters_tuning/
!hyperparameters_tuning/**
!*.ipynb

# Large / regenerable HPO reproduction artifacts
hyperparameters_tuning/results/**
!hyperparameters_tuning/results/.gitkeep
hyperparameters_tuning/vendor/**
!hyperparameters_tuning/vendor/README.md
hyperparameters_tuning/figures/*.jpg
hyperparameters_tuning/figures/*.png
hyperparameters_tuning/figures/*.pdf
!hyperparameters_tuning/figures/.gitkeep
hyperparameters_tuning/scripts/__pycache__/

# Python
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml

## Environments
.venv/
venv/
ENV/
.env
.env.*

## Jupyter
.ipynb_checkpoints/

## Logs / outputs
*.log
runs/
wandb/
tb_logs/

## Large / regenerable experiment checkpoints
paper/_tmp_b_feedb_cg/

